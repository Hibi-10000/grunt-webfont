{
  "typeAcquisition": {
    "enable": true,
  },
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "lib": ["ESNext"],
    "checkJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
		"resolveJsonModule": true
  },
	"include": ["tasks/*", "test/*"],
  "exclude": ["node_modules"],
}
