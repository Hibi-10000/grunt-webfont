{
  "typeAcquisition": {
    "enable": true,
  },
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ESNext",
    "lib": ["ESNext"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
		"resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
  },
	"include": ["tasks/*", "test/*.js"],
  "exclude": ["node_modules"],
}
