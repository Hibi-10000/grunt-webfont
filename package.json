{
  "name": "@hibi_10000/grunt-webfont",
  "description": "Ultimate SVG to webfont converter for Grunt.",
  "version": "2.0.1",
  "homepage": "https://github.com/Hibi-10000/grunt-webfont",
  "author": "Hibi_10000",
  "contributors": [
    "Artem Sapegin (http://sapegin.me/)",
    "Maxime Thirouin (http://moox.io/)",
    "Aaron Lampros (https://github.com/alampros)",
    "Cyrille Meichel (https://github.com/landru29)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hibi-10000/grunt-webfont.git"
  },
  "bugs": {
    "url": "https://github.com/Hibi-10000/grunt-webfont/issues"
  },
  "keywords": [
    "gruntplugin",
    "font",
    "webfont",
    "fontforge",
    "font-face",
    "woff",
    "woff2",
    "ttf",
    "svg",
    "eot",
    "truetype",
    "css",
    "icon"
  ],
  "license": "MIT",
  "main": "./dist/webfont.js",
  "exports": {
    "types": "./dist/webfont.d.ts",
    "default": "./dist/webfont.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "test:node": "node --test ./test/webfont.test.ts",
    "test:node:cov": "node --experimental-test-coverage --test ./test/webfont.test.ts",
    "pretest:grunt": "grunt clean webfont --gruntfile ./Gruntfile.ts --stack",
    "test:grunt": "node --test-only ./test/webfont.test.ts --no-clean"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^11",
      "onFail": "warn"
    }
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "consola": "^3.4.2",
    "eta": "^4.5.1",
    "glob": "^13.0.0",
    "temp": "^0.9.4",
    "ttf2woff2": "^8.0.0"
  },
  "optionalDependencies": {
    "svg2ttf": "^6.0.3",
    "svgicons2svgfont": "~15.0.1",
    "svgo": "^4.0.0",
    "ttf2eot": "^3.1.0",
    "ttf2woff": "^3.0.0",
    "which": "^6.0.0"
  },
  "devDependencies": {
    "@types/grunt": "^0.4.32",
    "@types/node": "^24.10.1",
    "@types/stylus": "^0.48.43",
    "@types/svg2ttf": "^5.0.3",
    "@types/temp": "^0.9.4",
    "@types/which": "^3.0.4",
    "fast-xml-parser": "^5.5.9",
    "grunt": "^1.6.1",
    "grunt-cli": "^1.5.0",
    "grunt-contrib-clean": "^2.0.1",
    "stylus": "^0.64.0",
    "tsdown": "^0.17.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "grunt": ">=0.4.0"
  }
}
